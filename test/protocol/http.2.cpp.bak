#include "../../src/protocol/http.hpp"
#include "../test.hpp"
#include <string_view>

using namespace protocol;
using namespace test;

using mss = std::map<std::string, std::string>;

// Assuming these helpers exist or are implemented in your framework
constexpr HTTP::Request Request(HTTP::Method, const std::string&, HTTP::Version, const mss&, const std::string&);
constexpr HTTP::Response Response(HTTP::Version, int, const mss& headers, const std::string& body);
constexpr void assert_equal(const HTTP::Response& l, const HTTP::Response& r);
constexpr void assert_equal(const HTTP::Request& l, const HTTP::Request& r);

int flag = 0;

int protocol_http(int argc, char* argv[])
{
  int _i = 0, _j = 0;
  bool _exception_caught;

  SECTION("request deserialization - standard cases")
  {
    REQUIRE({
      const auto raw = "GET /index.html HTTP/1.1\r\nHost: localhost\r\n\r\n";
      const auto expected = Request(HTTP::GET, "/index.html", HTTP::HTTP_11, {{"Host", "localhost"}}, "");
      assert_equal(HTTP::Request(raw), expected);
    });

    REQUIRE({
      const auto raw = "POST /login HTTP/1.1\r\nContent-Length: 12\r\n\r\nuser=admin12";
      const auto expected =
          Request(HTTP::POST, "/login", HTTP::HTTP_11, {{"Content-Length", "12"}}, "user=admin12");
      assert_equal(HTTP::Request(raw), expected);
    });

    REQUIRE({
      const auto raw = "OPTIONS * HTTP/1.1\r\nCustom-Header: value\r\n\r\n";
      const auto expected = Request(HTTP::OPTIONS, "*", HTTP::HTTP_11, {{"Custom-Header", "value"}}, "");
      assert_equal(HTTP::Request(raw), expected);
    });
  }
  ENDSECTION;

  SECTION("request deserialization - edge cases")
  {
    // Test: Header case-insensitivity (RFC 9110)
    REQUIRE({
      const auto raw = "GET / HTTP/1.1\r\nhOsT: example.com\r\n\r\n";
      auto req = HTTP::Request(raw);
      if (!req.headers.count("host")) throw ComparisonException(0, 1);
    });

    // Test: Request with query parameters in URI
    REQUIRE({
      const auto raw = "GET /search?q=cpp+parser&lang=en HTTP/1.1\r\n\r\n";
      const auto expected = Request(HTTP::GET, "/search?q=cpp+parser&lang=en", HTTP::HTTP_11, {}, "");
      assert_equal(HTTP::Request(raw), expected);
    });

    // Test: Multi-line headers or extra whitespace (Robustness)
    REQUIRE({
      const auto raw = "GET / HTTP/1.1\r\nHost:    spaces.com    \r\n\r\n";
      const auto expected = Request(HTTP::GET, "/", HTTP::HTTP_11, {{"Host", "spaces.com"}}, "");
      assert_equal(HTTP::Request(raw), expected);
    });
  }
  ENDSECTION;

  SECTION("request deserialization - error handling")
  {
    REQUIRE_THROW("Empty request", HTTP::ParsingException, { const auto _ = HTTP::Request(""); });

    REQUIRE_THROW("Missing HTTP version", HTTP::ParsingException,
                  { const auto _ = HTTP::Request("GET /path\r\n\r\n"); });

    REQUIRE_THROW("Malformed header (missing colon)", HTTP::ParsingException,
                  { const auto _ = HTTP::Request("GET / HTTP/1.1\r\nBadHeaderValue\r\n\r\n"); });

    REQUIRE_THROW("Invalid Method", HTTP::ParsingException,
                  { const auto _ = HTTP::Request("FLY /sky HTTP/1.1\r\n\r\n"); });
  }
  ENDSECTION;

  SECTION("response deserialization")
  {
    NREQUIRE("200 OK with Body", {
      const auto raw = "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 13\r\n\r\nHello, World!";
      const auto expected = Response(HTTP::HTTP_11, 200,
                                     {{"Content-Type", "text/plain"}, {"Content-Length", "13"}}, "Hello, World!");
      assert_equal(HTTP::Response(raw), expected);
    });

    NREQUIRE("404 Not Found", {
      const auto raw = "HTTP/1.1 404 Not Found\r\n\r\n";
      const auto expected = Response(HTTP::HTTP_11, 404, {}, "");
      assert_equal(HTTP::Response(raw), expected);
    });

    NREQUIRE("500 Internal Server Error", {
      const auto raw = "HTTP/1.1 500 Internal Server Error\r\nContent-Length: 0\r\n\r\n";
      const auto expected = Response(HTTP::HTTP_11, 500, {{"Content-Length", "0"}}, "");
      assert_equal(HTTP::Response(raw), expected);
    });
  }
  ENDSECTION;

  SECTION("serialization (Object to String)")
  {
    // Ensure that what we parse can be perfectly reconstructed
    NREQUIRE("Request Round-trip", {
      const std::string raw = "GET /round-trip HTTP/1.1\r\nHost: test.com\r\n\r\n";
      auto req = HTTP::Request(raw);
      // Assuming a .to_string() or similar method exists
      if (std::string(req) != raw) throw ComparisonException(std::string(req), raw);
    });

    NREQUIRE("Response Round-trip", {
      const std::string raw = "HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nHello";
      auto res = HTTP::Response(raw);
      if (std::string(res) != raw) throw ComparisonException(std::string(res), raw);
    });
  }
  ENDSECTION;

  return flag;
}

constexpr protocol::HTTP::Request Request(HTTP::Method method, const std::string& url, HTTP::Version version,
                                          const std::map<std::string, std::string>& headers,
                                          const std::string& body)
{
  HTTP::Request req;
  req.method = method;
  req.url = url;
  req.version = version;
  req.headers = headers;
  req.body = body;
  return req;
}

constexpr protocol::HTTP::Response Response(HTTP::Version version, int status,
                                            const std::map<std::string, std::string>& headers,
                                            const std::string& body)
{
  protocol::HTTP::Response res;
  res.version = version;
  res.status = status;
  res.headers = headers;
  res.body = body;
  return res;
}

constexpr void assert_equal(const HTTP::Request& l, const HTTP::Request& r)
{
  if (l.method != r.method)
    throw ComparisonException(HTTP::method_to_string(l.method), HTTP::method_to_string(r.method));
  if (l.url != r.url) throw ComparisonException(l.url, r.url);
  if (l.version != r.version)
    throw ComparisonException(HTTP::version_to_string(l.version), HTTP::version_to_string(r.version));
  if (l.headers != r.headers) throw ComparisonException(l.headers, r.headers);
  if (l.body != r.body) throw ComparisonException(l.body, r.body);
}

constexpr void assert_equal(const HTTP::Response& l, const HTTP::Response& r)
{
  if (l.version != r.version)
    throw ComparisonException(HTTP::version_to_string(l.version), HTTP::version_to_string(r.version));
  if (l.status != r.status) throw ComparisonException(l.status, r.status);
  if (l.headers != r.headers) throw ComparisonException(l.headers, r.headers);
  if (l.body != r.body) throw ComparisonException(l.body, r.body);
}

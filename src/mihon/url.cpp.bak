#include "url.hpp"

#include "../../logger/logger.hpp"
#include "iterator.hpp"
#include <memory>
#include <string>
#include <string_view>

namespace protocol
{
struct Router::ISegment
{
  enum
  {
    SEGMENT,
    AUTH_SEGMENT,
  } type;

  virtual HTTP::Response resolve(Iterator&, HTTP::Request&) = 0;
  virtual ISegment* nnn(std::string_view) = 0;
  virtual ISegment* ddd(std::string_view, std::unique_ptr<ISegment>) = 0;
  virtual ~ISegment() = default;
  virtual bool callback(HTTP::Method) = 0;
};

struct Router::Segment : Router::ISegment
{
public:
  Segment() { this->type = SEGMENT; };

  HTTP::Response resolve(Iterator&, HTTP::Request&) override
  {
    static_assert(false, "Method `resolve` is not implemented.");
  }

  ISegment* ddd(std::string_view _segment_name, std::unique_ptr<ISegment> _segment) override
  {
    for (const auto& segment : this->table_)
    {
      if (segment.first == _segment_name)
      {
        auto log = Logger::New();
        log.crit("path already exists");
        throw "";
      }
    }

    // Delete called on 'protocol::Router::ISegment' should not be an issue
    this->table_.push_back({std::string(_segment_name), std::move(_segment)});
    return this->table_.end()->second.get();
  }

  ISegment* nnn(std::string_view _segment_name) override
  {
    for (const auto& segment : this->table_)
      if (segment.first == _segment_name) return segment.second.get();

    return nullptr;
  }

  bool callback(HTTP::Method _) override { return (bool)this->callbacks_[(size_t)_]; }

  Handler<HTTP> callbacks_[N_METHODS];
  std::vector<std::pair<std::string, std::unique_ptr<ISegment>>> table_;
};


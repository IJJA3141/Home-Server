void Router::add(HTTP::Method _method, std::string_view _path, Handler<HTTP> _callback)
{
  auto log = Logger::New();

  if (_path.empty() || _path[0] != '/')
  {
    log.crit("invalid path \"{}\"", _path);
    throw "";
  }

  ISegment* segment = this->root_.get();
  ISegment* new_segment = nullptr;

  // special case when adding to root since root has no parent
  Iterator url(_path);
  if (_path.size() != 1)
  {
    while (url.next('/') && !url.tail.empty())
    {
      new_segment = segment->nnn(url.head);
      if (new_segment == nullptr) new_segment = segment->ddd(url.head, std::make_unique<Segment>());
      segment = new_segment;
    }
  }

  new_segment = segment->nnn(url.tail);
  if (new_segment == nullptr)
  {
    new_segment = segment->ddd(url.tail, std::make_unique<Segment>());
  }
  else if (new_segment->ccc(_method))
  {
  }

  std::unique_ptr<Segment> new_segment = std::make_unique<Segment>();

  new_segment->callbacks_[(size_t)_method] = _callback;

  segment->ddd(url.tail, std::move(new_segment));

  // auto& callback = segment->callbacks_[(size_t)_method];
  // if (callback) log.warn("~ {} {}", HTTP::method_to_string(_method), _path);
  // else log.info("+ {} {}", HTTP::method_to_string(_method), _path);
  // callback = _callback;
}

HTTP::Response Router::resolve(HTTP::Request& _request) {}

